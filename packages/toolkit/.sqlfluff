[sqlfluff]
dialect = duckdb
templater = jinja
max_line_length = 88
exclude_rules = AL01,AL05,AL07,CP02,CP03,CV09,LT02,LT05,LT08,LT09,LT14,RF04,RF06,ST03,ST07,ST09,TQ01,TQ02,TQ03,TQ04,AM04

[sqlfluff:templater:jinja]
apply_dbt_builtins = False
loader_search_path = toolkit/executor/templates

[sqlfluff:templater:jinja:context]
secret = s
alias = a
project = "'project=p'"
type = postgres
host = "'h'"
port = 1
database = "'d'"
user = "'u'"
read_only = true
extensions = []
time_zone = "'America/Sao_Paulo'"
memory_limit = "'1GiB'"
temp_directory = "'/tmp/duck'"
source = "'a.csv'"
target = "'b.parquet'"
query = "'select 1'"
seconds = "3600"
columns = [{"source": "\"a\"", "target": "\"b\""}]
filters = ["(b = 1)"]
names = ["\"a\"", "\"b\""]
predicates = [{"column": "\"a\"", "op": ">=", "value": "1"}]
table = t
predicate = "a = 1"
column = "\"a\""
renames = []
spreadsheet = "'s'"
sheet = "'Sheet1'"
