# ==============================================================================
# AMBIENTE DE OPERAÇÃO
# ==============================================================================
# "local" = Docker PostgreSQL + PDFs/Artefatos locais
# "cloud" = Cloud SQL + Google Cloud Storage
ENVIRONMENT=...

# ==============================================================================
# BANCO DE DADOS (POSTGRESQL / CLOUD SQL)
# ==============================================================================
# URL local (Docker em localhost:5432)
DB_URL_LOCAL=postgresql:...

# URL Nuvem (Google Cloud SQL)
DB_URL_CLOUD=postgresql:...

# ==============================================================================
# DIRETÓRIOS E STORAGE
# ==============================================================================
# Caminhos locais dentro do workspace
LOCAL_PDFS_DIR=pipelines/rj_smtr__triagem_recursos/pdfs
LOCAL_ARTIFACTS_DIR=pipelines/rj_smtr__triagem_recursos/artifacts

# Configurações do Google Cloud Storage
GCS_BUCKET_NAME=...
GCS_PDFS_PREFIX=...
GCS_ARTIFACTS_PREFIX=...

# ==============================================================================
# VERTEX AI / GATEWAY BIFROST (LLM)
# ==============================================================================
LLM_PROVIDER=openai
LLM_MODEL=vertex/gemini-3.7-flash
BIFROST_VIRTUAL_KEY=sk-bf-...
BIFROST_BASE_URL=https:...

# ==============================================================================
# PARÂMETROS OPERACIONAIS DE TRIAGEM
# ==============================================================================
LIMIAR_ALTA_CONFIANCA=0.85
LIMIAR_BAIXA_CONFIANCA=0.50
LIMIAR_DISPERSAO_COT_MAX=0.50
MAX_PAGINAS_PDF_SMART_WINDOW=20

# ==============================================================================
# INTEGRAÇÃO SEI-RIO (MOD-WSSEI) - AMBIENTE DE HOMOLOGAÇÃO
# ==============================================================================
SEI_API_BASE_URL=https:...
SEI_SERVICE_USER=...
SEI_SERVICE_PASSWORD=...
SEI_ID_UNIDADE=...
SEI_ORGAO=...
SEI_TIMEOUT=60