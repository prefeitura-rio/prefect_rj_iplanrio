[
  {
    "$project": {
      "id": {
        "$toString": "$_id"
      },
      "driver": {
        "$toString": "$driver"
      },
      "associatedDiscount": {
        "$toString": "$associatedDiscount"
      },
      "ano_particao": {
        "$dateToString": {
          "format": "%Y",
          "date": "$dateTime"
        }
      },
      "mes_particao": {
        "$dateToString": {
          "format": "%m",
          "date": "$dateTime"
        }
      },
      "dia_particao": {
        "$dateToString": {
          "format": "%d",
          "date": "$dateTime"
        }
      },
      "dateTime": {
        "$toString": "$dateTime"
      }
    }
  },
  {
    "$unset": "_id"
  }
]
