# BigQuery Configuration
BIGQUERY_PROJECT_ID=your-project-id
BIGQUERY_DATASET_ID=your-dataset-id
BIGQUERY_TABLE_ID=your-table-id

# Data Relay API Configuration
DATA_RELAY_URL=https://data-relay.dados.rio/data/mailman
DATA_RELAY_API_KEY=your-api-key-here
DATA_RELAY_FROM_ADDRESS=noreply@example.com
DATA_RELAY_USE_GMAIL_API=false
DATA_RELAY_IS_HTML_BODY=true

# Retry and Throttle Settings
MAX_RETRIES=3
RETRY_DELAY=5
THROTTLE_DELAY=1
